# Required secrets — generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
JWT_SECRET=

# Optional
# SPRAYWALL_VERSION=latest   # pin a release, e.g. 1.0.0
# SPRAYWALL_WORKER_VERSION=latest-cuda   # NVIDIA GPU worker; match SPRAYWALL_VERSION, e.g. 1.0.0-cuda
# HTTP_PORT=80
# POSTGRES_USER=spraywall
# POSTGRES_DB=spraywall
# MINIO_ROOT_USER=spraywall
# MINIO_BUCKET=spraywall
# POLL_INTERVAL_SECONDS=5

# Single sign-on (OIDC) — off unless OIDC_ISSUER_URL is set; see the README
# OIDC_ISSUER_URL=https://id.example.com   # enables OIDC (discovery via /.well-known/openid-configuration)
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://spraywall.example.com/api/auth/oidc/callback
# OIDC_PROVIDER_NAME=SSO   # login button label, e.g. Pocket-ID
# OIDC_SCOPES=openid email profile groups
# OIDC_GROUPS_CLAIM=groups   # claim holding group names
# OIDC_ADMIN_GROUP=spraywall-admins   # members become instance admins; unset = roles never touched
# OIDC_ADMIN_MAX_AGE=24h   # admin rights lapse this long after the last SSO login
# PASSWORD_LOGIN_ENABLED=true   # false = SSO only (requires OIDC)

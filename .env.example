# Postgres
POSTGRES_USER=spraywall
POSTGRES_PASSWORD=spraywall
POSTGRES_DB=spraywall
DATABASE_URL=postgres://spraywall:spraywall@postgres:5432/spraywall?sslmode=disable

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=spraywall

# Server
PORT=8080
JWT_SECRET=dev-jwt-secret-change-me
# Comma-separated Immich hostnames (optionally host:port); empty disables Immich beta videos.
IMMICH_ALLOWED_HOSTS=

# Worker
POLL_INTERVAL_SECONDS=5
# Detection backend: "local" (CUDA if available, else CPU) or "modal" (serverless GPU)
INFERENCE_BACKEND=local
INSTALL_MODAL=false
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Single sign-on (OIDC) — off unless OIDC_ISSUER_URL is set. See README "Single sign-on (OIDC)".
# OIDC_ISSUER_URL=https://id.example.com          # enables OIDC (discovery via /.well-known/openid-configuration)
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=http://localhost:5173/api/auth/oidc/callback
# OIDC_PROVIDER_NAME=SSO                          # login button label
# OIDC_SCOPES=openid email profile groups
# OIDC_GROUPS_CLAIM=groups                        # claim holding group names
# OIDC_ADMIN_GROUP=spraywall-admins               # members become instance admins; unset = roles never touched
# OIDC_ADMIN_MAX_AGE=24h                          # admin rights lapse this long after the last SSO login
# PASSWORD_LOGIN_ENABLED=true                     # false = SSO only (requires OIDC)
